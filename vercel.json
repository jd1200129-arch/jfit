{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    }
  },
  "daemons": {
    "email-delivery": {
      "root": "apps/worker",
      "entrypoint": "Dockerfile.vercel",
      "replicas": {
        "iad1": 1
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
