# Copy to .env.local for local development. Never expose server secrets to browser/native clients.
DATABASE_URL=postgresql://jfit:jfit@localhost:5432/jfit
APP_URL=http://localhost:3000
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
SESSION_SECRET=replace-with-at-least-32-random-bytes
AUTH_RATE_LIMIT_SECRET=replace-with-a-different-32-byte-secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
PUSH_PROVIDER_CREDENTIALS=
FIXTURES_ENABLED=false
